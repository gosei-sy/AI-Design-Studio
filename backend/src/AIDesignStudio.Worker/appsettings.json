{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=aidesignstudio;Username=aids;Password=aids_dev_only"
  },
  "Storage": {
    "Local": {
      "RootPath": "./.local-assets"
    }
  },
  "Providers": {
    "Stitch": {
      "ExecutablePath": "stitch",
      "WorkingDirectory": ".",
      "TimeoutSeconds": 180,
      "BillableOperationsEnabled": false
