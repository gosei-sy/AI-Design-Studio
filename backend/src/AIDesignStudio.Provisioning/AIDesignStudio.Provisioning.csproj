<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>aids-provision</AssemblyName>
    <RootNamespace>AIDesignStudio.Provisioning</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AIDesignStudio.Infrastructure\AIDesignStudio.Infrastructure.csproj" />
  </ItemGroup>

  <!--
    The command-line parser is where the "no secret in argv" rule is enforced, so
    it is tested rather than trusted. Exposed to the unit test project only.
  -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>AIDesignStudio.UnitTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
