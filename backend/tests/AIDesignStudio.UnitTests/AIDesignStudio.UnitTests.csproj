<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <!--
      The corpus Ajv's verdicts are recorded in, shared with packages/contracts.
      Linked, not copied: SchemaConformanceTests must read the file the contracts
      package guards (M01-05).
    -->
    <EmbeddedResource Include="..\..\..\packages\contracts\conformance\design-contract.cases.json"
                      Link="Conformance\design-contract.cases.json"
                      LogicalName="Conformance.design-contract.cases.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AIDesignStudio.Application\AIDesignStudio.Application.csproj" />
    <ProjectReference Include="..\..\src\AIDesignStudio.Infrastructure\AIDesignStudio.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\AIDesignStudio.Provisioning\AIDesignStudio.Provisioning.csproj" />
    <ProjectReference Include="..\..\src\AIDesignStudio.Worker\AIDesignStudio.Worker.csproj" />
  </ItemGroup>

</Project>