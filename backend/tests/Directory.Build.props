<Project>

  <!-- Inherit the solution-wide settings, then add test-only ones. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- xUnit v3 test projects are self-hosting executables, not libraries. -->
    <OutputType>Exe</OutputType>

    <!--
      xUnit v3 runs on Microsoft.Testing.Platform. The MTP mode of "dotnet test"
      is enabled by the "test.runner" section in the repository's global.json;
      TestingPlatformDotnetTestSupport is the legacy VSTest-mode switch and is
      deliberately not set.
    -->

    <!-- Test assertions legitimately discard results and use fluent chains. -->
    <NoWarn>$(NoWarn);CA1861;xUnit1051</NoWarn>
  </PropertyGroup>

</Project>
