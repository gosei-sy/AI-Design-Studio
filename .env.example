# Copy to .env and fill in. .env is git-ignored and must never be committed.
#
# The API and worker read configuration from appsettings.json plus environment
# variables. ASP.NET Core maps "__" to a configuration section separator, so
# ConnectionStrings__Default overrides ConnectionStrings:Default.

# --- Database ---------------------------------------------------------------
# Matches docker-compose.yml. Development-only credentials.
ConnectionStrings__Default=Host=localhost;Port=5432;Database=aidesignstudio;Username=aids;Password=aids_dev_only

# --- Frontend ---------------------------------------------------------------
# Base URL of the API. NEXT_PUBLIC_ is required because client components read it,
# which also means it is visible in the browser: never put a secret here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5080

# --- Google Stitch ----------------------------------------------------------
# Stitch needs two independent credentials and both matter:
#
#   1. A Google OAuth sign-in, obtained interactively with `stitch login`. Tokens
#      are stored under ~/.stitch/credentials.json, NOT here.
#   2. A separate canvas API key, required for projects, screens, captures and
#      design systems. Being signed in is not sufficient.
#
# Leave STITCH_API_KEY unset to run without provider access: the adapter reports
# itself unusable and no feature silently degrades.
STITCH_API_KEY=

# Path to the stitch CLI. Leave as "stitch" when it is on PATH.
Providers__Stitch__ExecutablePath=stitch

# Cost guard. While false, the adapter refuses every billable provider call and
# serves only readiness probes and dry-run planning. Keep it false unless you
# intend to spend against the account.
Providers__Stitch__BillableOperationsEnabled=false

# --- Asset storage ----------------------------------------------------------
# Local filesystem backend for development. Deployed environments use Azure Blob
# Storage; its connection string is supplied by the platform, not by this file.
Storage__Local__RootPath=./.local-assets

# --- Integration tests ------------------------------------------------------
# Admin connection used to provision a throwaway test database per run. Points at
# the "postgres" database, not the application one.
AIDS_TEST_CONNECTION=Host=localhost;Port=5432;Database=postgres;Username=aids;Password=aids_dev_only
