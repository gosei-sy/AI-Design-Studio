{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidesignstudio.dev/schemas/design-contract-v1.json",
  "title": "Design Contract v1",
  "description": "The normative description of what a product must contain. This document, once approved, is the system's source of truth. AI provider output is evidence that a contract was satisfied; it is never itself the contract. The backend stores this payload as jsonb — the same JSON value, not the same bytes — and hashes the stored text at approval. This schema is the single definition of its shape for both the API and the studio UI.",
  "type": "object",
  "required": ["schemaVersion", "product", "informationArchitecture", "screens"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1,
      "description": "Schema generation. Bumped only for breaking changes; see docs/02-architecture/API_CONTRACTS.md."
    },
    "product": {
      "type": "object",
      "required": ["name", "platforms"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "summary": { "type": "string", "maxLength": 2000 },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["web", "mobile", "tablet"] },
          "description": "Target platforms. Drives which device variants each screen obligation requires."
        },
        "primaryAudience": { "type": "string", "maxLength": 500 }
      }
    },
    "informationArchitecture": {
      "type": "object",
      "required": ["flows"],
      "additionalProperties": false,
      "properties": {
        "flows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["key", "name", "steps"],
            "additionalProperties": false,
            "properties": {
              "key": { "$ref": "#/$defs/stableKey" },
              "name": { "type": "string", "minLength": 1, "maxLength": 200 },
              "steps": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["screenKey"],
                  "additionalProperties": false,
                  "properties": {
                    "screenKey": { "$ref": "#/$defs/stableKey" },
                    "note": { "type": "string", "maxLength": 500 }
                  }
                },
                "description": "Ordered screens in this flow. Every screenKey must appear in /screens; the API validates this referential rule, which JSON Schema alone cannot express."
              }
            }
          }
        }
      }
    },
    "screens": {
      "type": "array",
      "minItems": 1,
      "description": "Screen obligations. A screen listed here must exist and be approved before handoff.",
      "items": {
        "type": "object",
        "required": ["key", "title", "purpose"],
        "additionalProperties": false,
        "properties": {
          "key": { "$ref": "#/$defs/stableKey" },
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "description": "What a user accomplishes here. Reviewers judge generated output against this."
          },
          "requiredElements": {
            "type": "array",
            "items": { "type": "string", "minLength": 1, "maxLength": 200 },
            "description": "Elements that must be present. These are the checkable obligations in review."
          },
          "states": {
            "type": "array",
            "uniqueItems": true,
            "items": { "enum": ["default", "empty", "loading", "error", "success", "offline"] },
            "description": "States the screen must cover. Empty and error states are routinely forgotten by generative tools, so listing them makes the omission visible."
          },
          "devices": {
            "type": "array",
            "uniqueItems": true,
            "items": { "enum": ["mobile", "desktop", "tablet", "agnostic"] }
          }
        }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "conformanceTarget": {
          "enum": ["WCAG21A", "WCAG21AA", "WCAG22AA"],
          "default": "WCAG21AA"
        },
        "notes": { "type": "string", "maxLength": 2000 }
      }
    },
    "contentRules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tone": { "type": "string", "maxLength": 500 },
        "readingLevel": { "type": "string", "maxLength": 100 },
        "prohibited": {
          "type": "array",
          "items": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "description": "Unvalidated product assumptions this contract rests on. Recorded here rather than silently baked into requirements, so they can be challenged.",
      "items": {
        "type": "object",
        "required": ["statement"],
        "additionalProperties": false,
        "properties": {
          "statement": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "confidence": { "enum": ["low", "medium", "high"] },
          "validationPlan": { "type": "string", "maxLength": 1000 }
        }
      }
    }
  },
  "$defs": {
    "stableKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[-/][a-z0-9]+)*$",
      "description": "Lowercase slug or route-like path. Stable across versions: it is how a redesign matches new screens to the existing application."
    }
  }
}
